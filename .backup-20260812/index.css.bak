/* =========================================================
   FINANCIAL OBSERVATORY — DESIGN SYSTEM
   near-black / lime / off-white / editorial serif + mono
========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&display=swap');

:root {
  --bg: #0a0a0a;
  --bg-raised: #101010;
  --ink: #f4f3ee;
  --muted: #8a8a84;
  --muted-dim: #5c5c57;
  --lime: #c8ff00;
  --lime-dim: #9ecb00;
  --line: #232320;
  --line-strong: #35352f;
  --danger: #ff5d4a;
  --serif: "Fraunces", "Iowan Old Style", Georgia, serif;
  --mono: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  --max: 1200px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

#root {
  min-height: 100vh;
}

h1,
h2,
h3 {
  font-family: var(--serif);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.01em;
  margin: 0;
  color: var(--ink);
}

h1 {
  font-size: clamp(2.4rem, 5vw, 4.2rem);
}

h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

p {
  margin: 0;
  color: var(--muted);
}

a {
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

/* -----------------------------------------------------
   UTILITY TEXT STYLES
----------------------------------------------------- */

.eyebrow,
.system-label,
.mono-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--lime);
  margin: 0 0 14px 0;
  display: block;
}

.system-label,
.mono-meta {
  color: var(--muted);
}

.hero-copy,
.auth-description,
.landing-copy {
  font-size: 16px;
  color: var(--muted);
  max-width: 560px;
  margin-top: 18px;
}

/* -----------------------------------------------------
   BUTTONS + FORM CONTROLS (global reset)
----------------------------------------------------- */

button {
  font-family: inherit;
  cursor: pointer;
}

input,
select,
textarea {
  font-family: var(--sans);
  font-size: 15px;
  color: var(--ink);
  background: var(--bg-raised);
  border: 1px solid var(--line-strong);
  border-radius: 0;
  padding: 14px 16px;
  width: 100%;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  transition: border-color 180ms ease;
}

select {
  background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position: calc(100% - 20px) center, calc(100% - 15px) center;
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
  padding-right: 40px;
}

input::placeholder {
  color: var(--muted-dim);
}

input:hover,
select:hover {
  border-color: var(--muted);
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 1px solid var(--lime);
  outline-offset: 3px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 16px 26px;
  border: 1px solid transparent;
  border-radius: 0;
  transition: opacity 180ms ease, border-color 180ms ease, background-color 180ms ease;
  white-space: nowrap;
}

.button-primary {
  background: var(--lime);
  color: #08110a;
  border-color: var(--lime);
}

.button-primary:hover {
  opacity: 0.85;
}

.button-secondary {
  background: transparent;
  color: var(--ink);
  border-color: var(--line-strong);
}

.button-secondary:hover {
  border-color: var(--lime);
  color: var(--lime);
}

.back-link {
  display: inline-block;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 40px;
  transition: color 180ms ease;
}

.back-link:hover {
  color: var(--lime);
}

/* =========================================================
   LANDING
========================================================= */

.landing-shell {
  max-width: var(--max);
  margin: 0 auto;
  padding: 40px 32px 0;
}

.landing-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--line);
}

.brand {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--lime);
}

.landing-hero {
  padding: 120px 0 100px;
  max-width: 760px;
}

.landing-hero h1 {
  margin: 18px 0 28px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 28px;
  flex-wrap: wrap;
  margin-top: 40px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
}

.feature-card {
  padding: 40px 36px 60px 0;
  border-left: 1px solid var(--line);
  padding-left: 32px;
}

.feature-card:first-child {
  border-left: none;
  padding-left: 0;
}

.feature-number {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.1em;
  color: var(--lime);
  display: block;
  margin-bottom: 28px;
}

.feature-card h2 {
  font-family: var(--mono);
  font-size: 13px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 14px;
}

.feature-card p {
  font-size: 14px;
  line-height: 1.6;
}

/* =========================================================
   AUTH (LOGIN / SIGNUP)
========================================================= */

.auth-page {
  max-width: var(--max);
  margin: 0 auto;
  padding: 56px 32px 80px;
}

.auth-panel {
  max-width: 560px;
}

.auth-panel h1 {
  margin-top: 8px;
}

/* Vertical auth form: labels stack above their inputs */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: min(100%, 520px);
  margin-top: 32px;
}

.auth-form label {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 18px;
}

.auth-form label:first-child {
  margin-top: 0;
}

.auth-form input {
  width: 100%;
}

.auth-form .button {
  margin-top: 26px;
  align-self: flex-start;
}

.auth-footer {
  margin-top: 32px;
  font-size: 14px;
  color: var(--muted);
}

.auth-footer a {
  color: var(--lime);
  text-decoration: underline;
}

/* =========================================================
   ONBOARDING
========================================================= */

.onboarding {
  max-width: var(--max);
  margin: 0 auto;
  padding: 56px 32px 80px;
}

.onboarding h1 {
  margin-top: 8px;
}

.onboarding-progress {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  width: min(100%, 600px);
  margin-top: 48px;
}

.onboarding-step {
  position: relative;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  transition: color 180ms ease, border-color 180ms ease;
}

.onboarding-step.active {
  color: var(--lime);
  border-top-color: var(--lime);
}

.onboarding-actions {
  margin-top: 48px;
}

/* =========================================================
   DASHBOARD SHELL (Dashboard / Budgets / Settings / Ledger / Prediction)
========================================================= */

.dashboard {
  max-width: var(--max);
  margin: 0 auto;
  padding: 56px 32px 100px;
}

.dashboard-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.page-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.page-top .back-link {
  margin-bottom: 0;
}

/* Dashboard nav — spaced, uppercase mono links under the header */
.dashboard-nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.dashboard-nav a {
  color: var(--muted);
  text-decoration: none;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  transition: color 180ms ease;
}

.dashboard-nav a:hover {
  color: var(--lime);
}

/* Stat grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--line);
  border-top: none;
  margin-top: 0;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 28px 24px;
  border-left: 1px solid var(--line);
}

.stat-card:first-child {
  border-left: none;
}

.stat-card span {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.stat-card strong {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 2rem;
  color: var(--ink);
}

.stat-card small {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-dim);
}

/* Section wrapper reused across dashboard pages */
.dashboard-section {
  margin-top: 72px;
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 4px;
}

.section-header>a {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--lime);
  text-decoration: none;
}

/* Transactions */
.transaction-list {
  display: flex;
  flex-direction: column;
}

.transaction-list.large .transaction {
  padding: 22px 0;
}

.transaction {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.transaction span {
  font-size: 15px;
  color: var(--ink);
}

.transaction strong {
  font-family: var(--mono);
  font-size: 14px;
  color: var(--ink);
}

/* Intelligence / prediction preview card on dashboard */
.intelligence-card {
  border: 1px solid var(--line);
  padding: 40px;
  margin-top: 4px;
}

.intelligence-card p {
  font-size: 15px;
  max-width: 520px;
}

.intelligence-card strong {
  display: block;
  font-family: var(--serif);
  font-weight: 500;
  font-size: 2.6rem;
  color: var(--lime);
  margin: 16px 0;
}

.intelligence-card a {
  display: inline-block;
  margin-top: 22px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--lime);
  text-decoration: none;
}

/* =========================================================
   BUDGETS
========================================================= */

.budget-list {
  display: flex;
  flex-direction: column;
}

.budget-row {
  padding: 24px 0;
  border-bottom: 1px solid var(--line);
}

.budget-row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14px;
  gap: 16px;
}

.budget-row-top span {
  font-size: 15px;
  color: var(--ink);
}

.budget-row-top strong {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--muted);
  white-space: nowrap;
}

.budget-row-top strong.over {
  color: var(--danger);
}

.budget-bar {
  height: 4px;
  width: 100%;
  background: var(--line);
}

.budget-bar-fill {
  height: 100%;
  background: var(--lime);
}

.budget-bar-fill.over {
  background: var(--danger);
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.alert-item {
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
}

.alert-item span {
  display: inline-block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 8px;
}

.alert-item p {
  font-size: 14px;
  max-width: 560px;
}

/* =========================================================
   SETTINGS
========================================================= */

.settings-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: min(100%, 520px);
  margin-top: 8px;
}

.settings-form label {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 18px;
}

.settings-form label:first-child {
  margin-top: 0;
}

.settings-form .button {
  margin-top: 26px;
  align-self: flex-start;
}

.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 8px;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border: 1px solid var(--line-strong);
  font-size: 13px;
  color: var(--ink);
}

.category-tag button {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 15px;
  line-height: 1;
  padding: 0;
}

.category-tag button:hover {
  color: var(--danger);
}

.category-add-form {
  display: flex;
  gap: 12px;
  margin-top: 24px;
  max-width: 520px;
}

.category-add-form input {
  flex: 1;
}

.category-add-form .button {
  flex-shrink: 0;
}

.settings-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 24px 0;
  border-bottom: 1px solid var(--line);
}

.settings-toggle-row:last-child {
  border-bottom: none;
}

.settings-toggle-row strong {
  display: block;
  font-family: var(--sans);
  font-weight: 600;
  font-size: 15px;
  color: var(--ink);
  margin-bottom: 6px;
}

.settings-toggle-row p {
  font-size: 13px;
  max-width: 420px;
}

.toggle-button {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  padding: 10px 18px;
  border: 1px solid var(--line-strong);
  background: transparent;
  color: var(--muted);
  flex-shrink: 0;
}

.toggle-button.on {
  border-color: var(--lime);
  color: var(--lime);
}

/* =========================================================
   ADD EXPENSE
========================================================= */

.form-page {
  max-width: var(--max);
  margin: 0 auto;
  padding: 56px 32px 100px;
}

.form-page h1 {
  margin-top: 8px;
}

.expense-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: min(100%, 520px);
  margin-top: 40px;
}

.expense-form label {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 18px;
}

.expense-form label:first-child {
  margin-top: 0;
}

.amount-input {
  font-family: var(--serif);
  font-size: 2rem;
  padding: 18px 16px;
}

.expense-form .button {
  margin-top: 26px;
  width: 100%;
}

/* =========================================================
   TRANSACTION SUCCESS
========================================================= */

.success-page {
  max-width: var(--max);
  margin: 0 auto;
  padding: 140px 32px;
}

.success-page h1 {
  margin: 18px 0 20px;
}

.success-page .hero-copy {
  margin-bottom: 40px;
}

/* =========================================================
   PREDICTION
========================================================= */

.prediction-card {
  border: 1px solid var(--line);
  padding: 48px;
}

.prediction-card>span {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.prediction-card>strong {
  display: block;
  font-family: var(--serif);
  font-weight: 500;
  font-size: 3.4rem;
  color: var(--lime);
  margin: 16px 0 24px;
}

.prediction-card>p {
  max-width: 520px;
  font-size: 15px;
  margin-bottom: 40px;
}

.prediction-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  padding-top: 32px;
  border-top: 1px solid var(--line);
}

.prediction-meta span {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 12px;
}

.prediction-meta strong {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.6rem;
  color: var(--ink);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

  .dashboard-grid,
  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .feature-card:nth-child(2) {
    border-left: none;
    padding-left: 0;
  }

  .stat-card:nth-child(2n + 1) {
    border-left: none;
  }

  .stat-card:nth-child(n + 3) {
    border-top: 1px solid var(--line);
  }

  .prediction-meta {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

@media (max-width: 640px) {

  .dashboard-grid,
  .feature-grid,
  .onboarding-progress {
    grid-template-columns: 1fr;
  }

  .feature-card,
  .stat-card {
    border-left: none !important;
    border-top: 1px solid var(--line);
    padding-left: 0 !important;
  }

  .feature-card:first-child,
  .stat-card:first-child {
    border-top: none;
  }

  .category-add-form {
    flex-direction: column;
  }
}