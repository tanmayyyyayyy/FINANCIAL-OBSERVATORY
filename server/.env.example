# Server Port (Render sets PORT automatically; leave at 5001 for local dev)
PORT=5001

# Environment
NODE_ENV=development   # Set to "production" on Render

# -------------------------------------------------------
# CORS — Allowed frontend origins (comma-separated list)
# -------------------------------------------------------
# Primary name (matches Render env var):
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173
# Legacy alias (accepted but FRONTEND_ORIGIN takes precedence):
# CLIENT_ORIGIN=http://localhost:5173

# -------------------------------------------------------
# Google Gemini AI key — NEVER commit this value
# -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# Firebase Admin SDK credentials
# -------------------------------------------------------
FIREBASE_PROJECT_ID=financial-observatory-1b20e

# Option A (Recommended for Render): paste full service-account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: individual credential fields
# Use exactly ONE option (A or B).  Leave the other commented out.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@financial-observatory-1b20e.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Note: on Render, paste the private key value directly — Render handles escaping automatically.
