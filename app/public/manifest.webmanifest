{
  "name": "Financial Observatory",
  "short_name": "Observatory",
  "description": "A clearer view of your money.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#040405",
  "theme_color": "#040405",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Quick Add Expense",
      "short_name": "Quick Add",
      "description": "Log an expense in 5 seconds",
      "url": "/quick-add",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Voice Entry",
      "short_name": "Voice",
      "description": "Speak your expense aloud",
      "url": "/dashboard?action=voice",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Ask AI",
      "short_name": "Ask AI",
      "description": "Ask questions about your finances",
      "url": "/dashboard?action=ask",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Main Dashboard",
      "short_name": "Dashboard",
      "description": "View cash flow, budgets and insights",
      "url": "/dashboard",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
